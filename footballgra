        </button>
      ) : null}

      <button
        type="button"
        onClick={replay}
        style={{
          position: "fixed",
          right: 18,
          top: 18,
          zIndex: 5,
          border: "1px solid rgba(255,255,255,0.26)",
          borderRadius: 999,

// Chart sampling policy (used by Simulation.jsx + Charts.jsx)
export const DEFAULT_CHART_CONFIG = {
  sampleRate: 30, // Hz
  windowSec: 10, // keep last N seconds
  get maxPoints() {
    return Math.max(60, Math.floor(this.sampleRate * this.windowSec));
  },
};

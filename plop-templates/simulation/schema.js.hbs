/**
 * schema.js
 * Define default params + control UI schema + HUD schema + chart settings.
 *
 * Simulation: {{title}}
 * Registry Key: {{registryKey}}
 *
 * ✅ Edit this file first for ANY new simulation:
 * - DEFAULT_PARAMS: initial state
 * - CONTROL_SCHEMA: right panel controls UI
 * - HUD_SCHEMA: readouts list (HUD.jsx renders from this)
 * - DEFAULT_CHART_CONFIG: sampling window/cap
 */


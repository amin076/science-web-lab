rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function validUpload() {
      return request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('(image/.*|audio/.*|video/.*|text/plain|text/csv|application/pdf|application/zip|application/octet-stream|application/msword|application/vnd\\..*)');
    }
    // =========================
    // CLASS ATTACHMENTS
    // =========================
    match /attachments/{classId}/{expId}/{fileName} {

      allow write: if (request.resource == null || validUpload()) && request.auth != null &&
        firestore.get(/databases/(default)/documents/classes/$(classId)).data.teacherId
          == request.auth.uid;

      allow read: if request.auth != null && firestore.exists(/databases/(default)/documents/classes/$(classId)) && (
        firestore.get(/databases/(default)/documents/classes/$(classId)).data.teacherId
          == request.auth.uid ||

        (firestore.exists(
          /databases/(default)/documents/classes/$(classId)/students/$(request.auth.uid)
        ) || request.auth.uid in firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('approvedStudents', []))
      );
    }

    // =========================
    // STUDENT SUBMISSIONS
    // =========================
    match /submissions/{classId}/{expId}/{userId}/{fileName} {

      allow write: if (request.resource == null || validUpload()) && request.auth != null
        && firestore.exists(/databases/(default)/documents/classes/$(classId))
        && request.auth.uid == userId

        // NEW SECURITY CHECK
        && (firestore.exists(
          /databases/(default)/documents/classes/$(classId)/students/$(request.auth.uid)
        ) || request.auth.uid in firestore.get(/databases/(default)/documents/classes/$(classId)).data.get('approvedStudents', []));

      allow read: if request.auth != null && firestore.exists(/databases/(default)/documents/classes/$(classId)) && (

        request.auth.uid == userId ||

        firestore.get(/databases/(default)/documents/classes/$(classId)).data.teacherId
          == request.auth.uid
      );
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}